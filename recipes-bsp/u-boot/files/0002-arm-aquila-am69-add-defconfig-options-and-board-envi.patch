From 70ccdd334a57c1345ae72e8c489180e6b406ade9 Mon Sep 17 00:00:00 2001
From: Drew Moseley <drew@moseleynet.net>
Date: Mon, 18 May 2026 16:00:42 -0400
Subject: [PATCH 2/4] arm: aquila-am69: add defconfig options and board
 environment

Add the Toradex-BSP defconfig options and compiled-in environment for
the Aquila AM69 A72 build.

Boot / BSP options:
- DISTRO_DEFAULTS + BOOTCOMMAND="bootflow scan -b"
- PREBOOT constructs fdtfile from ${variant}/${fdt_board}
- ENV_VARS_UBOOT_RUNTIME_CONFIG for board detection
- BOOTCOUNT_LIMIT/ENV for watchdog-assisted boot fallback
- USB gadget / fastboot / UUU support
- board/toradex/aquila-am69/aquila-am69.env: boot_targets, console,
  memory addresses, DFU alt info, eMMC raw-write helpers for
  tiboot3/tispl/u-boot

Boot filesystem support (j784s4_evm_a72_defconfig enables these only in
SPL, so main U-Boot found no bootflows and 'mmc' was unknown):
- CMD_MMC, CMD_FAT/FS_FAT/FS_FAT_MAX_CLUSTSIZE, CMD_EXT4/EXT4_WRITE,
  CMD_FS_GENERIC
- LEGACY_IMAGE_FORMAT so the script bootmeth can parse the
  mkimage-wrapped boot.scr

Persistent env, EEPROM, board_late_init (missing vs the Toradex
production BSP, causing three defects):
- ENV_IS_IN_MMC on boot partition 1 (ENV_SIZE/ENV_OFFSET already agree);
  without an env backend the environment was read-only ("Loading
  Environment from nowhere"), BOOTCOUNT_ENV was a no-op, and a saved
  fdt_board could not persist
- I2C_EEPROM so the SoM/carrier EEPROM nodes (eeprom@50/@57) bind;
  otherwise get_tdx_eeprom() fails with "cannot find EEPROM by node"
- BOARD_LATE_INIT so board_late_init() -> detect_board_variant() runs
  and ${variant} is set
- CMD_ASKENV (update_* env macros) and SPL_ENV_SUPPORT for parity

Signed-off-by: Drew Moseley <drew.moseley@toradex.com>
Upstream-Status: Inappropriate [Toradex BSP staging]
---
 board/toradex/aquila-am69/aquila-am69.env | 47 +++++++++++++++++++++++
 configs/aquila-am69_a72_defconfig         | 43 +++++++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100644 board/toradex/aquila-am69/aquila-am69.env

diff --git a/board/toradex/aquila-am69/aquila-am69.env b/board/toradex/aquila-am69/aquila-am69.env
new file mode 100644
index 00000000000..34f2e63f706
--- /dev/null
+++ b/board/toradex/aquila-am69/aquila-am69.env
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Default environment for Toradex Aquila AM69 SoM
+ *
+ * Copyright 2024 Toradex - https://www.toradex.com/
+ */
+
+#include <env/ti/k3_rproc.env>
+
+boot_script_dhcp=boot.scr
+boot_targets=mmc1 mmc0 dhcp
+console=ttyS2
+fdt_addr_r=0x90200000
+fdt_board=dev
+kernel_addr_r=0x82000000
+kernel_comp_addr_r=0x80200000
+kernel_comp_size=0x08000000
+ramdisk_addr_r=0x90300000
+scriptaddr=0x90280000
+
+dfu_alt_info_ram=
+	tispl.bin ram 0x80080000 0x200000;
+	u-boot.img ram 0x81000000 0x400000;
+	loadaddr ram 0x82000000 0x80000;
+	scriptaddr ram 0x90280000 0x80000;
+	ramdisk_addr_r ram 0x90300000 0x8000000
+
+update_tiboot3=
+	askenv confirm Did you load tiboot3-am69-hs-fs-aquila.bin (y/N)?;
+	if test $confirm = y; then
+		setexpr blkcnt ${filesize} + 0x1ff && setexpr blkcnt ${blkcnt} / 0x200;
+		mmc dev 0 1; mmc write ${loadaddr} 0x0 ${blkcnt};
+	fi
+
+update_tispl=
+	askenv confirm Did you load tispl.bin (y/N)?;
+	if test $confirm = y; then
+		setexpr blkcnt ${filesize} + 0x1ff && setexpr blkcnt ${blkcnt} / 0x200;
+		mmc dev 0 1; mmc write ${loadaddr} 0x400 ${blkcnt};
+	fi
+
+update_uboot=
+	askenv confirm Did you load u-boot.img (y/N)?;
+	if test $confirm = y; then
+		setexpr blkcnt ${filesize} + 0x1ff && setexpr blkcnt ${blkcnt} / 0x200;
+		mmc dev 0 1; mmc write ${loadaddr} 0x1400 ${blkcnt};
+	fi
diff --git a/configs/aquila-am69_a72_defconfig b/configs/aquila-am69_a72_defconfig
index f66495fd1d5..a1be2e9e01f 100644
--- a/configs/aquila-am69_a72_defconfig
+++ b/configs/aquila-am69_a72_defconfig
@@ -22,3 +22,46 @@ CONFIG_ENV_SIZE=0x2000
 CONFIG_ENV_OFFSET=0xFFFFDE00
 CONFIG_SYS_PROMPT="Aquila AM69 # "
 CONFIG_BOOTDELAY=1
+CONFIG_LEGACY_IMAGE_FORMAT=y
+CONFIG_DISTRO_DEFAULTS=y
+CONFIG_BOOTCOMMAND="bootflow scan -b"
+CONFIG_USE_PREBOOT=y
+CONFIG_PREBOOT="test -n ${fdtfile} || setenv fdtfile k3-am69-aquila${variant}-${fdt_board}.dtb"
+CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
+CONFIG_CMD_BOOTCOUNT=y
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
+# Persistent environment in eMMC boot partition 1 (matches Toradex BSP layout).
+# Without a backend the env is read-only ("Environment from nowhere") and
+# CONFIG_BOOTCOUNT_ENV above is a no-op.
+CONFIG_ENV_IS_IN_MMC=y
+CONFIG_SYS_MMC_ENV_PART=1
+CONFIG_ENV_OVERWRITE=y
+CONFIG_SYS_RELOC_GD_ENV_ADDR=y
+CONFIG_SPL_ENV_SUPPORT=y
+# update_tiboot3/update_tispl/update_uboot env macros use askenv.
+CONFIG_CMD_ASKENV=y
+# CONFIG_CMD_EXPORTENV is not set
+# Run board_late_init() -> detect_board_variant() so ${variant} is set.
+CONFIG_BOARD_LATE_INIT=y
+# Bind the SoM/carrier I2C EEPROMs (eeprom@50/@57) so get_tdx_eeprom() and
+# the Toradex config-block reads work instead of "cannot find EEPROM by node".
+CONFIG_I2C_EEPROM=y
+CONFIG_USB_GADGET_MANUFACTURER="Toradex"
+CONFIG_USB_GADGET_VENDOR_NUM=0x1b67
+CONFIG_USB_GADGET_PRODUCT_NUM=0x4000
+CONFIG_USB_GADGET_OS_DESCRIPTORS=y
+CONFIG_USB_FUNCTION_FASTBOOT=y
+CONFIG_FASTBOOT_BUF_ADDR=0xC0000000
+CONFIG_FASTBOOT_BUF_SIZE=0x2F000000
+CONFIG_FASTBOOT_FLASH=y
+CONFIG_FASTBOOT_UUU_SUPPORT=y
+CONFIG_FASTBOOT_FLASH_MMC_DEV=0
+CONFIG_FASTBOOT_CMD_OEM_FORMAT=y
+CONFIG_CMD_MMC=y
+CONFIG_CMD_FAT=y
+CONFIG_FS_FAT=y
+CONFIG_FS_FAT_MAX_CLUSTSIZE=16384
+CONFIG_CMD_EXT4=y
+CONFIG_CMD_EXT4_WRITE=y
+CONFIG_CMD_FS_GENERIC=y
-- 
