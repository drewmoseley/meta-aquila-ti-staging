diff --git a/arch/arm/dts/k3-am69-r5-aquila-dev.dts b/arch/arm/dts/k3-am69-r5-aquila-dev.dts
new file mode 100644
index 00000000000..82911594243
--- /dev/null
+++ b/arch/arm/dts/k3-am69-r5-aquila-dev.dts
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * Copyright 2024 Toradex
+ *
+ * U-Boot R5 device tree for Toradex Aquila AM69 SoM on Aquila Development Board.
+ *
+ * k3-am69-aquila-dev.dts (in dts/upstream/src/arm64/ti/) is included as the base
+ * SoM+carrier board DTS.  The Aquila DDR table replaces the SK DDR table.
+ * k3-am69-aquila-dev-u-boot.dtsi provides binman nodes and bootph-* annotations.
+ */
+
+/dts-v1/;
+
+#include "k3-am69-aquila-dev.dts"
+#include "k3-am69-aquila-lpddr4-4266.dtsi"
+#include "k3-j784s4-ddr.dtsi"
+#include "k3-am69-aquila-dev-u-boot.dtsi"
+#include "k3-j784s4-r5.dtsi"
+
+/*
+ * k3-j784s4-r5.dtsi references &tps62873a for wkup_vtm0 vdd-supply-2.
+ * Define the Aquila VDD_CPU_AVS regulator (tps6287x at wkup_i2c0 0x40)
+ * with the tps62873a label so the phandle resolves.
+ */
+&wkup_i2c0 {
+	tps62873a: regulator@40 {
+		compatible = "ti,tps6287x";
+		reg = <0x40>;
+		regulator-name = "VDD_CPU_AVS";
+		regulator-min-microvolt = <750000>;
+		regulator-max-microvolt = <1330000>;
+		regulator-boot-on;
+		regulator-always-on;
+		bootph-pre-ram;
+	};
+};
